{
  "name": "Attendance Dashboard Pro",
  "version": "2.5",
  "manifest_version": 3,
  "description": "Bảng điều khiển chấm công hiện đại cho Asoft",
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "permissions": [
    "cookies",
    "storage"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/Contentmaster/Index/HRM/HRMF2260*",
        "https://*/Contentmaster/Index/HRM/HRMF2260*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}